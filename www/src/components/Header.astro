---
import Wordmark from './ui/Wordmark.astro';
import IconMenu from './icons/IconMenu.astro';
import MobileMenu from './MobileMenu.astro';
---

<header>
  <div>
    <Wordmark />

    <nav id="primary-nav" aria-label="Navigation principale">
      <ul role="list">
        <li><a href="/#competences">Compétences</a></li>
        <li><a href="/#projets">Projets</a></li>
        <li><a href="/#talks">Conférences</a></li>
        <li><a href="/#blog">Blog</a></li>
        <li><a href="/#contact">Contact</a></li>
      </ul>
    </nav>

    <a href="/#contact" class="site-header__cta">
      <span class="pill" aria-hidden="true"></span>
      je suis disponible&nbsp;!
      <span class="sr-only">aller à la section contact</span>
    </a>

    <button
      type="button"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      id="burger-btn"
    >
      <IconMenu aria-hidden="true" />
    </button>

    <MobileMenu />
  </div>
</header>


<script>
  const burger = document.getElementById('burger-btn');
  const closeBtn = document.getElementById('mobile-menu-close');
  const header = document.querySelector('header');
  const dialogEl = document.getElementById('mobile-menu');
  const dialog = dialogEl instanceof HTMLDialogElement ? dialogEl : null;

  function syncHeaderHeight(): void {
    if (header) {
      document.documentElement.style.setProperty('--tc-header-height', `${header.getBoundingClientRect().height}px`);
    }
  }
  syncHeaderHeight();
  window.addEventListener('resize', syncHeaderHeight);

  burger?.addEventListener('click', () => {
    dialog?.showModal();
    burger.setAttribute('aria-expanded', 'true');
    burger.setAttribute('aria-label', 'Fermer le menu');
  });

  closeBtn?.addEventListener('click', () => dialog?.close());

  dialog?.addEventListener('close', () => {
    burger?.setAttribute('aria-expanded', 'false');
    burger?.setAttribute('aria-label', 'Ouvrir le menu');
  });

  dialog?.addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key !== 'Tab' || !dialog) return;

    const focusable = [closeBtn, ...Array.from(dialog.querySelectorAll<HTMLAnchorElement>('a[href]'))]
      .filter((el): el is HTMLElement => el !== null);
    if (focusable.length === 0) return;

    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    const active = document.activeElement;

    if (event.shiftKey && active === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && active === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>

<style>
  header {
    position: sticky; top: 0; z-index: 50;
    background: var(--tc-bg);
    border-bottom: var(--tc-border);
  }
  header > div {
    max-width: var(--tc-container); margin: 0 auto;
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--tc-space-5);
    padding: 18px var(--tc-space-6);
  }

  nav ul {
    display: flex; gap: var(--tc-space-6); align-items: center;
    list-style: none; margin: 0; padding: 0;
  }
  nav a {
    font-size: 15px; font-weight: 700;
    color: var(--tc-fg-1); text-decoration: none;
  }
  nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  nav a:focus-visible {
    outline: 3px solid var(--tc-pink);
    outline-offset: 3px;
    border-radius: 3px;
  }

  .site-header__cta {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 9px 18px;
    font-family: var(--tc-font-sans); font-weight: 700; font-size: 14px;
    color: var(--tc-fg-3); text-decoration: none;
    white-space: nowrap;
    background: var(--tc-bg);
    border: 2px solid var(--tc-fg); border-radius: var(--tc-radius-pill);
    box-shadow: var(--tc-shadow-sm);
    transition: transform 0.1s ease, box-shadow 0.1s ease, background 0.15s ease;
  }
  .site-header__cta:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 0 var(--tc-success);
  }
  .site-header__cta:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0 0 var(--tc-success); }
  .site-header__cta:focus-visible { outline: 3px solid var(--tc-success); outline-offset: 2px; }
  .site-header__cta .pill {
    width: 9px; height: 9px; border-radius: 50%;
    background: var(--tc-success); display: inline-block;
    position: relative; flex: none;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--tc-success) 28%, transparent);
  }
  .site-header__cta .pill::after {
    content: ""; position: absolute; inset: 0;
    border-radius: 50%; border: 2px solid var(--tc-success);
    opacity: 0; transform: scale(1);
  }
  .site-header__cta:hover .pill::after,
  .site-header__cta:focus-visible .pill::after {
    animation: cta-ping 0.7s ease-out 1;
  }
  @keyframes cta-ping {
    0%   { transform: scale(0.7); opacity: 0.8; }
    100% { transform: scale(2.4); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header__cta:hover .pill::after,
    .site-header__cta:focus-visible .pill::after { animation: none; }
  }

  button {
    display: none;
    width: 44px; height: 44px;
    flex-shrink: 0;
    align-items: center; justify-content: center;
    background: var(--tc-bg);
    border: var(--tc-border); border-radius: var(--tc-radius);
    color: var(--tc-fg-1);
    box-shadow: var(--tc-shadow-sm);
  }
  button:focus-visible {
    outline: 3px solid var(--tc-pink);
    outline-offset: 2px;
  }
  button :global(svg) { width: 24px; height: 24px; }

  @media (min-width: 761px) and (max-width: 930px) {
    .site-header__cta { display: none }
  }
  @media (max-width: 760px) {
    header > div { padding: 14px var(--tc-space-4); }
    nav { display: none; }
    button { display: inline-flex; }

    header :global(.wordmark) { flex: 1; min-width: 0; }
    header :global(.wordmark__text) { min-width: 0; }
    header :global(.wordmark__name) {
      display: block;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
  }

  @media (max-width: 510px) {
    .site-header__cta { display: none }
  }
</style>
