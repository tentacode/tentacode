---
import FaceSmileIcon from "astro-heroicons/outline/FaceSmile.astro";
import EnvelopeIcon from "astro-heroicons/outline/Envelope.astro";
import MicrophoneIcon from "astro-heroicons/outline/Microphone.astro";
import SparklesIcon from "astro-heroicons/outline/Sparkles.astro";
import RocketLaunchIcon from "astro-heroicons/outline/RocketLaunch.astro";
import MoonIcon from "astro-heroicons/outline/Moon.astro";
import SunIcon from "astro-heroicons/outline/Sun.astro";
import DarkModeToggle from "./DarkModeToggle.astro";

---
<nav aria-label="Menu principal">
    <ul>
        <li>
            <a href="#a-propos">
                <FaceSmileIcon />
                À propos</a>
        </li>
        <li>
            <a href="#expertise"><RocketLaunchIcon />Expertise</a>
        </li>
        <li>
            <a href="#portfolio"><SparklesIcon />Portfolio</a>
        </li>
        <li>
            <a href="#conferences"><MicrophoneIcon />Conférences</a>
        </li>
        <li>
            <a href="#contact"><EnvelopeIcon />Contact</a>
        </li>
        <li>
            <button id="theme-toggle">
                <span class="icon-dark"><MoonIcon stroke-width="2" /></span>
                <span class="icon-light"><SunIcon stroke-width="2" /></span>
                Changer le thème
            </button>

            <DarkModeToggle />
        </li>
    </ul>
</nav>

<style>
    nav {
        padding: 40px ;
    }

    ul {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    a, button {
        background: none;
        display: flex;
        align-items: center;
        gap: 15px;
        font-family: "Lexend Deca", sans-serif;
        font-size: 1.8rem;
        font-weight: 500;
        letter-spacing: 0.15em;
        text-decoration: none;
        padding: 10px 20px;
        color: var(--text);
        border: 4px solid transparent;
        border-radius: 15px;
        margin: 0;
        cursor: pointer;
        text-align: right;
    }

    a:hover, a:focus, button:hover, button:focus {
        border: 4px solid var(--accent);
        outline: 2px solid var(--accent);
        outline-offset: 4px;
        transform: translateY(-3px);
        transition: transform 0.2s ease;
    }

    a svg, button svg {
        flex-shrink: 0;
        color: var(--text);
        opacity: 0;
        width: 40px;
        height: 40px;
        vertical-align: middle;
        stroke-width: 1.5px;
    }

    a:hover svg, a:focus svg, button:hover svg, button:focus svg {
        color: var(--accent);
        opacity: 1;
        transition: color 0.8s ease, opacity 0.8s ease;
    }

    #theme-toggle {
        display: none;
    }

    .icon-dark { display: none; }
    .icon-light { display: block; }

    :global([data-theme="dark"]) .icon-dark { display: block; }
    :global([data-theme="dark"]) .icon-light { display: none; }

    @media (max-width: 1680px) {
        a, button {
            font-size: 1.6rem;
            padding: 8px 16px;
        }
    }

    @media (max-width: 1400px) {
        nav {
            padding: 20px ;
        }

        #theme-toggle {
            display: flex;
        }
        
        ul {
            margin-top: 20px;
            margin-left: 15px;
            margin-right: 15px;
            flex-direction: column;
            align-items: flex-end;
            gap: 20px;
        }

        a, button {
            font-size: 1.8rem;
            padding: 10px 20px;
            width: fit-content;
        }

        a svg, button svg {
            opacity: 1;
            width: 30px;
            height: 30px;
        }
    }

    @media (max-width: 450px) {
        nav {
            padding: 10px ;
        }
        ul {
            gap: 10px;
        }

        a, button {
            font-size: 1.4rem;
            padding: 8px 16px;
        }

        a svg, button svg {
            width: 25px;
            height: 25px;
        }
    }
</style>

<script>
    const btn = document.getElementById('theme-toggle');

    function updateLabel() {
        const isDark = document.documentElement.dataset.theme === 'dark';
        btn.setAttribute('aria-label', isDark ? 'Changer le thème pour un thème clair' : 'Changer le thème pour un thème sombre');
    }

    updateLabel();

    btn.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme;
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
        updateLabel();
    });
</script>