---
import IconOctopus from '../icons/IconOctopus.astro';

interface Props {
  size?: 'sm' | 'lg';
  backLabel?: string;
}

const { size = 'sm', backLabel } = Astro.props;
---

<a href="/" class:list={['wordmark', `wordmark--${size}`, backLabel && 'wordmark--back']} aria-label="tentacode.dev — accueil">
  <IconOctopus eyeBg="var(--eye-bg)" aria-hidden="true" />
  <span class="wordmark__text">
    {backLabel && <span class="wordmark__back">{backLabel}</span>}
    <span class="wordmark__name">tentacode<span>.</span>dev</span>
  </span>
</a>

<style>
  .wordmark {
    display: inline-flex; align-items: center; gap: 9px;
    font-family: var(--tc-font-display);
    font-weight: 700; letter-spacing: -0.02em;
    text-decoration: none;
    line-height: 1;
  }
  .wordmark--sm {
    font-size: 24px;
    color: var(--tc-fg-1);
    --eye-bg: var(--tc-bg);
  }
  .wordmark--lg {
    font-size: 28px;
    color: var(--tc-bg);
    --eye-bg: var(--tc-fg-1);
  }

  svg {
    flex: none;
    transition: transform 0.25s cubic-bezier(.2,.85,.25,1);
    transform-origin: 50% 70%;
  }
  .wordmark--sm svg { width: 30px; height: 30px; }
  .wordmark--lg svg { width: 34px; height: 34px; }

  .wordmark:hover svg { transform: rotate(-6deg) scale(1.06); }
  @media (prefers-reduced-motion: reduce) {
    .wordmark:hover svg { transform: none; }
  }

  .wordmark__text {
    display: flex; flex-direction: column; gap: 1px;
  }

  .wordmark__name span { color: var(--tc-accent); }
  .wordmark--lg .wordmark__name span { color: var(--tc-accent-soft); }

  .wordmark__back {
    font-size: 11px; font-weight: 700;
    color: var(--tc-fg-3);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    line-height: 1;
  }
  .wordmark--back:hover .wordmark__back { color: var(--tc-accent); }
</style>
