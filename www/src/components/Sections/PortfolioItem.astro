---
import { Image } from "astro:assets";
import PlusIcon from "astro-heroicons/outline/Plus.astro";
import MinusIcon from "astro-heroicons/outline/Minus.astro";
import ExternalLink from "../Elements/ExternalLink.astro";


const href = Astro.props.href || false;
---
<div class="portfolioItem">
    <h3>
        {href ? <ExternalLink href={href}>{Astro.props.name}</ExternalLink> : Astro.props.name}
    </h3>
    <Image src={Astro.props.image} alt={Astro.props.imageAlt} />
    <p>{Astro.props.description}</p>
    <div class="portfolioItemHeader">
        <button
            class="drawerButton"
            aria-expanded="false"
            aria-controls={`drawer-${Astro.props.drawerId}`}
        >
            <span class="plusIcon"><PlusIcon /></span>
            <span class="minusIcon"><MinusIcon /></span>
            {Astro.props.buttonText || `voir les détails du projet ${Astro.props.name}`}
        </button>
    </div>
    <div id={`drawer-${Astro.props.drawerId}`} class="drawer">
        <slot />
    </div>
</div>

<style>
    .portfolioItem {
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 30px;
    }

    img {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 30px;
    }

    .portfolioItemHeader {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    h3 {
        font-family: "Lexend Deca", sans-serif;
        font-size: 3em;
        font-weight: 500;
        margin: 0;
    }

    p {
        margin: 0;
    }

    button {
        background: none;
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: "Lexend Deca", sans-serif;
        font-size: 1.5em;
        font-weight: 500;
        color: var(--text);
        border: 4px solid var(--text);
        border-radius: 15px;
        padding: 10px 20px;
        cursor: pointer;
    }

    button:hover, button:focus {
        border: 4px solid var(--accent);
        outline: 2px solid var(--accent);
        outline-offset: 4px;
        transform: translateY(-3px);
        transition: transform 0.2s ease;
    }

    .minusIcon {
        display: none;
    }

    button svg {
        flex-shrink: 0;
        color: var(--text);
        width: 30px;
        height: 30px;
        stroke-width: 3px;
        margin-top: 0.2em; 
    }

    button:hover svg, button:focus svg {
        color: var(--accent);
        opacity: 1;
        transition: color 0.8s ease, opacity 0.8s ease;
    }

    .drawer {
        display: none;
        flex-direction: column;
        gap: 30px;
        font-size: 1.2em;
    }

    @media (max-width: 480px) {
        h3 {
            font-size: 2.2em;
        }
    }
</style>

<script define:vars={{ drawerId: Astro.props.drawerId }}>
    const button = document.querySelector(`.drawerButton[aria-controls="drawer-${drawerId}"]`);
    const drawer = document.getElementById(`drawer-${drawerId}`);

    button.addEventListener("click", () => {
        const expanded = button.getAttribute("aria-expanded") === "true";
        button.setAttribute("aria-expanded", String(!expanded));
        drawer.style.display = expanded ? "none" : "flex";
        button.querySelector(".plusIcon").style.display = expanded ? "inline" : "none";
        button.querySelector(".minusIcon").style.display = expanded ? "none" : "inline";
    });
</script>