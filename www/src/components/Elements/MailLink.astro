---
import EnvelopeIcon from "astro-heroicons/outline/Envelope.astro";
---
<style>
    a {
        display: inline;
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 4px;
        width: fit-content;
        text-wrap: balance;
        word-break: break-all;
    }

    a svg {
        margin-top: -0.15em;
        width: 1em;
        height: 1em;
        vertical-align: middle;
    }

    a:hover {
        text-decoration: wavy underline var(--accent);
    }

    a:focus {
        outline: 1px solid var(--accent);
        border-radius: 7px;
        padding: 0 5px;
        text-decoration: none;
        transition: padding 0.3s ease;
    }
</style>

<a 
    href={Astro.props.href}
><slot /> <EnvelopeIcon /></a>