---
import ArrowTopRightOnSquareIcon from "astro-heroicons/outline/ArrowTopRightOnSquare.astro";

const slotContent = await Astro.slots.render('default');
const textContent = slotContent.replace(/<[^>]*>/g, '').trim();
const ariaDescribedby = Astro.props["aria-describedby"];
---
<style>
    a {
        display: inline;
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 4px;
        width: fit-content;
        text-wrap: balance;
    }

    a svg {
        margin-top: -0.15em;
        margin-left: 0.25em;
        width: 1em;
        height: 1em;
        vertical-align: middle;
    }

    a:hover {
        text-decoration: wavy underline var(--accent);
    }

    a:focus {
        outline: 1px solid var(--accent);
        border-radius: 7px;
        padding: 0 5px;
        text-decoration: none;
        transition: padding 0.3s ease;
    }
</style>

<a 
    aria-label={`${textContent}, nouvelle fenêtre`}
    {...(ariaDescribedby && { "aria-describedby": ariaDescribedby })}
    href={Astro.props.href}
    target="_blank"
    rel="noopener noreferrer"
><slot /><ArrowTopRightOnSquareIcon /></a>