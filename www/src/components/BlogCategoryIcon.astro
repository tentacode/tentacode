---
import IconRobot from './icons/IconRobot.astro';
import IconCircles from './icons/IconCircles.astro';
import IconPerson from './icons/IconPerson.astro';

interface Props {
  icon: 'ai' | 'lead' | 'a11y';
  size: 's' | 'm' | 'l';
}

const { icon, size } = Astro.props;
---
{icon === 'ai' && <IconRobot size={size} stroke-width="2" aria-hidden="true" />}
{icon === 'a11y' && <IconCircles size={size} stroke-width="2" aria-hidden="true" />}
{icon === 'lead' && <IconPerson size={size} stroke-width="2" aria-hidden="true" />}
