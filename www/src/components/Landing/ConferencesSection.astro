---
import { getCollection } from 'astro:content';
import ConferenceItem from './ConferenceItem.astro';

const conferences = (await getCollection('conferences')).sort((a, b) => a.id.localeCompare(b.id));
---

<section class="confs" id="confs" aria-labelledby="confs-title">
  <div class="tc-container">
    <div class="section-head">
      <div>
        <span class="tc-eyebrow tc-eyebrow--dot">Sur scène</span>
        <h2 id="confs-title">Conférences et talks</h2>
      </div>
    </div>

    <ul class="confs__list">
      {conferences.map((conf) => (
        <ConferenceItem
          title={conf.data.title}
          occurrences={conf.data.occurrences}
          cohost={conf.data.cohost}
          cohostUrl={conf.data.cohostUrl}
          linkLabel={conf.data.linkLabel}
          href={conf.data.href}
        />
      ))}
    </ul>
  </div>
</section>

<style>
  .confs { padding: var(--tc-space-8) 0; }
  .confs__list {
    list-style: none; padding: 0; margin: 0;
    border-top: 1px solid var(--tc-fg-1);
  }
</style>
