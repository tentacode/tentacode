---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const allProjects = await getCollection('projets');
const projects = allProjects.sort((a, b) => b.id.localeCompare(a.id));
---

<section class="projects" id="projects" aria-labelledby="projects-title">
  <div class="tc-container">
    <div class="section-head">
      <div>
        <span class="tc-eyebrow tc-eyebrow--dot">Portfolio</span>
        <h2 id="projects-title">Projets variés et de qualité</h2>
      </div>
    </div>

    <div class="projects__bento">
      {projects.map((p) => (
        <ProjectCard
          variant={p.data.variant}
          href={`/projets/${p.data.slug}`}
          title={p.data.title}
          description={p.data.description}
          tags={p.data.tags}
          image={p.data.image}
          imageAlt={p.data.imageAlt}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .projects { padding: var(--tc-space-9) 0 var(--tc-space-8); }
  .projects__bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: 240px;
    gap: var(--tc-space-5);
  }

  /* Grid placement */
  :global(.project--featured) { grid-column: span 4; grid-row: span 2; }
  :global(.project--sm) { grid-column: span 2; grid-row: span 1; }

  @media (max-width: 1080px) {
    .projects__bento { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 220px; }
    :global(.project--featured) { grid-column: span 2; grid-row: span 2; }
    :global(.project--sm) { grid-column: span 1; }
  }
  @media (max-width: 760px) {
    .projects__bento { grid-template-columns: 1fr; grid-auto-rows: auto; }
    :global(.project--featured),
    :global(.project--sm) { grid-column: span 1; grid-row: auto; min-height: 280px; }
  }
</style>
