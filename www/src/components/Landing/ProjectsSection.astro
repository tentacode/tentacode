---
import ProjectCard from './ProjectCard.astro';
import IconArrowRight from '../icons/IconArrowRight.astro';
---

<section class="projects" id="projects" aria-labelledby="projects-title">
  <div class="tc-container">
    <div class="section-head">
      <div>
        <span class="tc-eyebrow tc-eyebrow--dot">Portfolio</span>
        <h2 id="projects-title">Projets variés et de qualité.</h2>
      </div>
      <a class="section-head__link" href="/projets">
        Tout voir
        <IconArrowRight aria-hidden="true" />
      </a>
    </div>

    <div class="projects__bento">
      <ProjectCard
        variant="featured"
        href="/projets/dashboard-keyboard-first"
        title="Dashboard SaaS — refonte clavier-first"
        description="Refonte d'un dashboard B2B de 200 écrans pour qu'il soit pleinement navigable au clavier et au lecteur d'écran. Score Lighthouse a11y : 64 → 100."
        tags={["react", "aria", "audit", "RGAA"]}
        mediaClass="media-1"
      />
      <ProjectCard
        variant="sm"
        href="/projets/editeur-collaboratif"
        title="Éditeur temps réel"
        description="CRDT, offline-first, livré seul en 6 semaines."
        tags={["yjs", "tiptap"]}
        mediaClass="media-2"
      />
      <ProjectCard
        variant="sm"
        href="/projets/refonte-checkout"
        title="Refonte checkout e-commerce"
        description="Lead d'une équipe de 3, drop-off réduit de 22%."
        tags={["next.js", "stripe"]}
        mediaClass="media-3"
      />
      <ProjectCard
        variant="sm"
        href="/projets/audit-a11y-consumer-app"
        title="Audit RGAA + remediation"
        description="App grand public 40 écrans, liste priorisée + PRs."
        tags={["audit", "RGAA"]}
        mediaClass="media-4"
      />
      <ProjectCard
        variant="sm"
        href="/projets/automatisation-back-office"
        title="Back-office assisté par AI"
        description="Workflows internes outillés avec Claude API."
        tags={["claude", "node"]}
        mediaClass="media-5"
      />
      <ProjectCard
        variant="sm"
        href="/projets/app-mobile-accessible"
        title="App mobile accessible"
        description="React Native, audit VoiceOver / TalkBack inclus."
        tags={["react native", "a11y"]}
        mediaClass="media-6"
      />
    </div>
  </div>
</section>

<style>
  .projects { padding: var(--tc-space-9) 0 var(--tc-space-8); }
  .projects__bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: 240px;
    gap: var(--tc-space-5);
  }

  /* Grid placement */
  :global(.project--featured) { grid-column: span 4; grid-row: span 2; }
  :global(.project--sm) { grid-column: span 2; grid-row: span 1; }

  /* Media swatches */
  :global(.media-1) { background: repeating-linear-gradient(45deg, #E8E4F8 0 10px, #FFF5F3 10px 20px); }
  :global(.media-2) { background: var(--tc-fg-1); color: var(--tc-bg); }
  :global(.media-2) :global(.project__media-placeholder) { color: rgba(255, 245, 243, 0.55); }
  :global(.media-3) { background: var(--tc-accent); }
  :global(.media-4) { background: repeating-linear-gradient(0deg, #FFF5F3 0 12px, #F5E9E5 12px 24px); }
  :global(.media-5) { background: #F3D9A4; }
  :global(.media-6) { background: #B7DBC2; }

  @media (max-width: 1080px) {
    .projects__bento { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 220px; }
    :global(.project--featured) { grid-column: span 2; grid-row: span 2; }
    :global(.project--sm) { grid-column: span 1; }
  }
  @media (max-width: 760px) {
    .projects__bento { grid-template-columns: 1fr; grid-auto-rows: auto; }
    :global(.project--featured),
    :global(.project--sm) { grid-column: span 1; grid-row: auto; min-height: 280px; }
  }
</style>
