<section class="blog" id="blog" aria-labelledby="blog-title">
  <div class="tc-container">
    <div class="section-head">
      <div>
        <span class="tc-eyebrow tc-eyebrow--dot">Blog</span>
        <h2 id="blog-title">Sur le blog</h2>
      </div>
    </div>

    <div class="blog__placeholder">
      <div class="blog__placeholder-text">
        <p>Accessibilité, qualité et réflexions.</p>
        <p class="blog__coming-soon">Les premiers articles arrivent bientôt.</p>
      </div>
      <CodingIllustration />
    </div>

