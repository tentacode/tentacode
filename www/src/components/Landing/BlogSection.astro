---
import BlogItem from './BlogItem.astro';
---

<section class="blog" id="blog" aria-labelledby="blog-title">
  <div class="tc-container">
    <div class="section-head">
      <div>
        <span class="tc-eyebrow tc-eyebrow--dot">Derniers articles</span>
        <h2 id="blog-title">Sur le blog.</h2>
      </div>
      <a class="section-head__link" href="/blog">
        Tous les articles
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>

    <div class="blog__grid">
      <BlogItem
        href="/blog/agent-claude-au-quotidien"
        category="AI"
        date="12 mar. 2026"
        title="Vivre un mois avec un agent dans son terminal."
        excerpt="Bilan honnête après 30 jours à coder en tandem avec Claude Code : ce qui change vraiment, et ce qui n'a pas changé du tout."
      >
        <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2" />
          <path d="M9 9h.01" />
          <path d="M15 9h.01" />
          <path d="M9 15c1 1 2 1.5 3 1.5s2-.5 3-1.5" />
        </svg>
      </BlogItem>

      <BlogItem
        href="/blog/rgaa-checklist-pragmatique"
        category="Accessibilité"
        date="28 jan. 2026"
        title="Une checklist RGAA pragmatique, en 20 lignes."
        excerpt="Pas de magie : juste les bons réflexes à intégrer dans la PR, le code review et la recette. Ça épargne 80% des galères en fin de projet."
      >
        <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10" />
          <circle cx="12" cy="12" r="4" />
        </svg>
      </BlogItem>

      <BlogItem
        href="/blog/lead-sans-burn"
        category="Lead"
        date="14 déc. 2025"
        title="Tenir une équipe sans la cramer."
        excerpt="La productivité n'est pas un sprint, c'est une cadence soutenable. Sept choses concrètes que je fais, en lead, pour préserver le cerveau collectif."
      >
        <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
          <circle cx="9" cy="7" r="4" />
        </svg>
      </BlogItem>
    </div>
  </div>
</section>

<style>
  .blog { padding: var(--tc-space-8) 0; }
  .blog__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--tc-space-6); }

  @media (max-width: 1080px) {
    .blog__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    .blog__grid { grid-template-columns: 1fr; }
  }
</style>
