<style>
  .blog { padding: var(--tc-space-8) 0; padding-bottom: 0 !important; }

  .blog__placeholder {
    display: flex;
    align-items: start;
    gap: var(--tc-space-8);
  }
  .blog__placeholder-text {
    flex: 1;
  }
  .blog__placeholder-text p {
    font-size: var(--tc-fs-h4);
    color: var(--tc-fg-2);
    max-width: 40ch;
  }
  .blog__coming-soon {
    font-style: italic;
    color: var(--tc-fg-3);
    font-size: var(--tc-fs-body) !important;
  }
  .blog__placeholder :global(svg) {
    flex-shrink: 0;
    width: 320px;
    height: 320px;
    margin-top: -90px;
  }

  .blog__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--tc-space-6); }

  @media (max-width: 760px) {
    .blog__placeholder { flex-direction: column; }
    .blog__placeholder :global(svg) { width: 240px; height: 240px; margin-top: -60px; }
    .blog__grid { grid-template-columns: 1fr; }
  }
  @media (min-width: 761px) and (max-width: 1080px) {
    .blog__grid { grid-template-columns: 1fr 1fr; }
  }
</style>
