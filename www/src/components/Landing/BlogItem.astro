---
import BlogCategoryIcon from '../BlogCategoryIcon.astro';
import type { BlogCategoryIcon as BlogCategoryIconType } from '../../types';

interface Props {
  href: string;
  category: string;
  categoryIcon: BlogCategoryIconType;
  date: string;
  dateAriaLabel?: string;
  title: string;
  excerpt: string;
}

const { href, category, categoryIcon, date, dateAriaLabel, title, excerpt } = Astro.props;
---

<div class="post">
  <a class="post__title" href={href}><h3>{title}</h3></a>
  <p>{excerpt}</p>
  <div class="post__meta">
    <span class="post__category">
      <BlogCategoryIcon icon={categoryIcon} size="s" />
      {category}
    </span>
    <span class="post__date" aria-label={dateAriaLabel ?? date}>{date}</span>
  </div>
</div>

<style>
  .post {
    display: flex; flex-direction: column; gap: var(--tc-space-3);
    text-decoration: none; color: var(--tc-fg-1);
    border-top: 3px solid var(--tc-fg-1);
    padding-top: var(--tc-space-4);
    transition: color 0.15s ease;
  }
  .post__meta {
    order: 1;
    display: flex; align-items: center; justify-content: space-between;
    font-family: var(--tc-font-mono); font-size: 12px;
    text-transform: uppercase; letter-spacing: 0.05em;
  }
  .post__category {
    display: inline-flex; align-items: center; gap: 6px;
    color: var(--tc-fg-1); font-weight: 700;
  }
  .post__category :global(svg) { width: 16px; height: 16px; }
  .post__date { color: var(--tc-fg-3); }
  .post__title {
    order: 2;
    font-family: var(--tc-font-display); font-weight: 700;
    font-size: 22px; line-height: 1.2; margin: 0;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .post__title:hover { text-decoration: underline; }
  .post__title:focus-visible { outline: 3px solid var(--tc-pink); outline-offset: 4px; border-radius: 3px; }
  p { font-size: 14px; color: var(--tc-fg-2); margin: 0; line-height: 1.5; order: 3; }
</style>
