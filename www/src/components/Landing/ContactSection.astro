---
import ContactChannel from './ContactChannel.astro';
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="tc-container contact__inner">
    <div>
      <span class="tc-eyebrow tc-eyebrow--dot">Discutons</span>
      <h2 id="contact-title">On en parle ?</h2>
      <p class="contact__lead">
        Une mission, un CDI, un audit, une conf à co-animer, un café pour faire connaissance. Je réponds vite et sans formulaire à rallonge.
      </p>
    </div>

    <div class="contact__channels">
      <ContactChannel href="mailto:hello@tentacode.dev" label="Mail" value="hello@tentacode.dev">
        <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <polyline points="22,7 12,13 2,7" />
        </svg>
      </ContactChannel>

      <ContactChannel href="https://www.linkedin.com/in/gabrielpillet" label="LinkedIn" value="/in/gabrielpillet" external>
        <svg slot="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.26 2.37 4.26 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45C23.2 24 24 23.23 24 22.28V1.72C24 .77 23.2 0 22.22 0z"/>
        </svg>
      </ContactChannel>

      <ContactChannel href="https://github.com/tentacode" label="GitHub" value="/tentacode" external>
        <svg slot="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.36-3.88-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.17a11.05 11.05 0 0 1 5.8 0c2.2-1.49 3.18-1.17 3.18-1.17.62 1.58.23 2.75.11 3.04.74.8 1.18 1.82 1.18 3.07 0 4.41-2.69 5.38-5.25 5.66.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
        </svg>
      </ContactChannel>

      <ContactChannel href="https://cv.tentacode.dev" label="CV" value="Mon CV en ligne" external>
        <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
          <polyline points="14 2 14 8 20 8" />
          <line x1="8" y1="13" x2="16" y2="13" />
          <line x1="8" y1="17" x2="13" y2="17" />
        </svg>
      </ContactChannel>
    </div>
  </div>
</section>

<style>
  .contact { padding: var(--tc-space-9) 0; position: relative; }
  .contact__inner {
    display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--tc-space-8);
    align-items: center;
  }
  .contact h2 {
    font-size: clamp(36px, 5vw, 56px); letter-spacing: -0.025em;
    margin: var(--tc-space-2) 0 var(--tc-space-5);
  }
  .contact__lead {
    font-size: 18px; color: var(--tc-fg-2); margin: 0 0 var(--tc-space-6);
    max-width: 48ch;
  }
  .contact__channels { display: flex; flex-direction: column; gap: var(--tc-space-3); }

  @media (max-width: 760px) {
    .contact__inner { grid-template-columns: 1fr; gap: var(--tc-space-6); }
  }
</style>
