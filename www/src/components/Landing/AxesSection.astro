---
import AxisCard from './AxisCard.astro';
import IconCode from '../icons/IconCode.astro';
import IconUsers from '../icons/IconUsers.astro';
import IconTarget from '../icons/IconTarget.astro';
import IconRobotFull from '../icons/IconRobotFull.astro';
---

<section class="axes" id="axes" aria-labelledby="axes-title">
  <div class="tc-container">
    <div class="section-head">
      <div>
        <span class="tc-eyebrow tc-eyebrow--dot">Ce que je fais</span>
        <h2 id="axes-title">Quatre axes, un seul interlocuteur.</h2>
      </div>
    </div>

    <div class="axes__grid">
      <AxisCard
        num="01 / DEV"
        variant="dev"
        title="Dev fullstack"
        description="Back, front, infra. Du ticket à la prod, en passant par les tests. PHP/Symfony et PostgreSQL en confort, React / Next / Astro en façade."
        tags={["symfony", "postgres", "react", "next.js"]}
      >
        <IconCode slot="icon" aria-hidden="true" />
      </AxisCard>

      <AxisCard
        num="02 / LEAD"
        variant="lead"
        title="Lead technique"
        description="Management bienveillant d'équipes 2–8 devs. Direction technique d'agence en arrière-plan. Productivité durable, plutôt que cadence à crédit."
        tags={["team lead", "code review", "mentorat"]}
      >
        <IconUsers slot="icon" aria-hidden="true" />
      </AxisCard>

      <AxisCard
        num="03 / A11Y"
        variant="a11y"
        title="Accessibilité"
        description="Formé à l'audit RGAA. WCAG AA par défaut, lecteurs d'écran testés à la main. Sur le web comme sur le mobile, sans poudre aux yeux."
        tags={["RGAA", "WCAG AA", "audit", "NVDA / VoiceOver"]}
      >
        <IconTarget slot="icon" aria-hidden="true" />
      </AxisCard>

      <AxisCard
        num="04 / AI"
        variant="ai"
        title="AI & automatisation"
        description="Dev assisté par AI au quotidien — Claude Code, Skills, API. Outillage interne, agents, automatisations métier. Sans hype et sans magie noire."
        tags={["claude code", "skills", "agents"]}
      >
        <IconRobotFull slot="icon" aria-hidden="true" />
      </AxisCard>
    </div>
  </div>
</section>

<style>
  .axes { padding: var(--tc-space-8) 0; }
  .axes__grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: var(--tc-space-5);
  }

  @media (max-width: 1080px) {
    .axes__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .axes__grid { grid-template-columns: 1fr; }
  }
</style>
