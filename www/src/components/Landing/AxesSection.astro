---
import AxisCard from './AxisCard.astro';
import IconCode from '../icons/IconCode.astro';
import IconUsers from '../icons/IconUsers.astro';
import IconTarget from '../icons/IconTarget.astro';
import IconRobotFull from '../icons/IconRobotFull.astro';
---

<section class="axes" id="axes" aria-labelledby="axes-title">
  <div class="tc-container">
    <div class="section-head">
      <div>
        <span class="tc-eyebrow tc-eyebrow--dot">Ce que j'apporte</span>
        <h2 id="axes-title">Mon expertise</h2>
      </div>
    </div>

    <div class="axes__grid">
      <AxisCard
        num="01 / DEV"
        variant="dev"
        title="Dev fullstack"
        description="Du backend au frontend avec un soupçon d'infra. J'aime rendre simple les problèmes complexes. Je pousse la qualité mais sans oublier qu'à un moment il faut livrer."
        tags={["Symfony", "PostgreSQL", "React", "React Native", "Next.js"]}
      >
        <IconCode slot="icon" aria-hidden="true" />
      </AxisCard>

      <AxisCard
        num="02 / LEAD"
        variant="lead"
        title="Lead technique"
        description="Que ce soit pour apporter une architecture technique, faire monter en compétences des juniors ou aider des seniors à prendre du recul, j'apporte un management technique vraiment bienveillant et au service de l'équipe."
        tags={["vision", "pédagogie", "code review", "santé mentale", "1:1"]}
      >
        <IconUsers slot="icon" aria-hidden="true" />
      </AxisCard>

      <AxisCard
        num="03 / A11Y"
        variant="a11y"
        title="Accessibilité"
        description="Nos applications devraient être utilisables par tous, sans exception, et j'ai toutes les compétences en accessibilité numérique pour développer et tester des solutions inclusives. Je suis également formé à l'audit RGAA et peux évaluer la conformité de vos projets."
        tags={["RGAA", "RAAM", "audits", "VoiceOver"]}
      >
        <IconTarget slot="icon" aria-hidden="true" />
      </AxisCard>

      <AxisCard
        num="04 / I.A."
        variant="ai"
        title="I.A. & automatisation"
        description="Avant l'I.A. j'automatisais déjà des process, mais aujourd'hui les possibilités sont bluffantes ! J'utilise Claude en assistant et en dev agentique dans tous mes projets, et je prends soin de garder le contrôle sur la qualité en sortie."
        tags={["claude code", "skills", "agents"]}
      >
        <IconRobotFull slot="icon" aria-hidden="true" />
      </AxisCard>
    </div>
  </div>
</section>

<style>
  .axes { padding: var(--tc-space-8) 0; }
  .axes__grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: var(--tc-space-5);
  }

  @media (max-width: 1080px) {
    .axes__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .axes__grid { grid-template-columns: 1fr; }
  }
</style>
