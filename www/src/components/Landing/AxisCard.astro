---
interface Props {
  num: string;
  variant: 'dev' | 'lead' | 'a11y' | 'ai';
  title: string;
  description: string;
  tags: string[];
}

const { num, variant, title, description, tags } = Astro.props;
---

<article class={`axis-card axis-card--${variant}`}>
  <span class="axis-card__num">{num}</span>
  <div class="axis-card__icon" aria-hidden="true">
    <slot name="icon" />
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  <div class="axis-card__tags" aria-label="Technologies">
    {tags.map((tag) => <span class="axis-card__tag">{tag}</span>)}
  </div>
</article>

<style>
  .axis-card {
    --axis-color: var(--tc-fg-1);
    position: relative;
    background: var(--tc-bg);
    color: var(--tc-fg-1);
    border: 6px solid var(--axis-color);
    border-radius: var(--tc-radius);
    padding: var(--tc-space-6) var(--tc-space-5) var(--tc-space-5);
    display: flex; flex-direction: column; gap: var(--tc-space-3);
    min-height: 320px;
    box-shadow: 6px 6px 0 0 var(--axis-color);
    overflow: hidden;
  }
  .axis-card__num {
    font-family: var(--tc-font-mono); font-size: 12px; font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--tc-fg-2);
  }
  .axis-card__icon {
    width: 64px; height: 64px;
    display: flex; align-items: center; justify-content: center;
    margin: 4px 0 var(--tc-space-3);
  }
  .axis-card__icon :global(svg) { width: 56px; height: 56px; stroke-width: 1.75; stroke: var(--axis-color); }
  h3 { font-size: 24px; margin: 0; letter-spacing: -0.02em; }
  p { font-size: 15px; line-height: 1.55; margin: 0; color: var(--tc-fg-2); }
  .axis-card__tags { margin-top: auto; padding-top: var(--tc-space-4); display: flex; flex-wrap: wrap; gap: 6px; }
  .axis-card__tag {
    font-family: var(--tc-font-mono); font-size: 11px;
    padding: 3px 8px;
    border: 2px solid var(--axis-color);
    border-radius: 6px;
    background: rgba(255,255,255,0.5);
    color: var(--tc-fg-1);
  }

  .axis-card--dev  { --axis-color: var(--tc-accent); }
  .axis-card--lead { --axis-color: var(--tc-turquoise); }
  .axis-card--a11y { --axis-color: var(--tc-pink); }
  .axis-card--ai   { --axis-color: var(--tc-fg-1); }

  @media (max-width: 760px) {
    .axis-card { min-height: 0; }
  }
</style>
