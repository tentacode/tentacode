---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Tag } from '../../types';

interface Props {
  href: string;
  variant: 'featured' | 'sm';
  title: string;
  description: string;
  tags: Tag[];
  image: ImageMetadata;
  imageAlt: string;
}

const { href, variant, title, description, tags, image, imageAlt } = Astro.props;
---

<div class={`project project--${variant}`}>
  <div class="project__media">
    <Image src={image} alt="" />
  </div>
  <div class="project__body">
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
    <span class="sr-only">Liste de tags :</span>
    <ul class="project__tags">
      {tags.map((tag) => <li class="project__tag" lang={tag.lang}>{tag.label}</li>)}
    </ul>
  </div>
</div>

<style>
  .project {
    display: flex; flex-direction: column;
    border: var(--tc-border); border-radius: var(--tc-radius);
    background: var(--tc-surface);
    box-shadow: var(--tc-shadow);
    overflow: hidden;
    text-decoration: none;
    color: var(--tc-fg-1);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
    cursor: pointer;
  }
  .project:hover { transform: translate(-2px, -2px); box-shadow: var(--tc-shadow-lg); }
  .project a { text-decoration: none; color: inherit; }
  .project a:focus-visible { outline: 3px solid var(--tc-pink); outline-offset: 2px; border-radius: var(--tc-radius-sm); }
  .project__media {
    aspect-ratio: 16 / 9;
    border-bottom: var(--tc-border);
    position: relative;
    overflow: hidden;
  }
  .project__media img {
    order: 1;
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
  }
  .project__tags { list-style: none; order: 2; display: flex; flex-wrap: wrap; gap: 6px; margin: 6px 0 10px; padding: 0; }
  .project__tag {
    font-family: var(--tc-font-mono); font-size: 11px;
    padding: 3px 8px;
    background: var(--tc-bg); border: 2px solid var(--tc-fg-1);
    border-radius: 6px; color: var(--tc-fg-1);
    line-height: 1.3;
  }
  .project__body { display: flex; flex-direction: column; gap: 2px; padding: var(--tc-space-4) var(--tc-space-5) var(--tc-space-5); }
  h3 {
    order: 3;
    font-family: var(--tc-font-display); font-weight: 700;
    font-size: 20px; margin: 0; letter-spacing: -0.01em; line-height: 1.2;
  }
  p { order: 4; font-size: 14px; color: var(--tc-fg-2); margin: 0; line-height: 1.5; }

  .project--featured h3 { font-size: 28px; }
  .project--featured p { font-size: 16px; max-width: 56ch; }
  .project--featured .project__tag { font-size: 12px; padding: 4px 10px; }

  .project--sm .project__body { padding: 14px 18px 18px; }
  .project--sm h3 { font-size: 16px; }
  .project--sm p {
    font-size: 13px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  const card = document.querySelectorAll('.project');

  // Gérer les clics sur chaque carte.
  card.forEach((c) => {
    c.addEventListener('click', () => {
      const link = c.querySelector('a');
      if (link) {
        window.location.href = link.href;
      }
    });
  });
</script>