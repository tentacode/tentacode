---
import { Image } from 'astro:assets';
import IconArrowRight from '../icons/IconArrowRight.astro';
import hljs from 'highlight.js/lib/core';
import php from 'highlight.js/lib/languages/php';
import portrait from '../../assets/img/portrait.jpg';

hljs.registerLanguage('php', php);

const code = `try {
    $cup = ($this->brewCoffeeQuery)();
    $me->drink($cup);
} catch (OutOfBeansException $e) {
    Sentry::captureMessage("La journée va être compliquée…");
}`;

const highlighted = hljs.highlight(code, { language: 'php' }).value;
---

<div class="hero" aria-labelledby="hero-title">
  <div class="tc-container">
    <div class="hero__content">
      <h1 id="hero-title">
        Développeur fullstack, lead technique, sensible à l'<span>accessibilité</span>.
      </h1>

      <p class="hero__lead">
        Près de 20&nbsp;ans à concevoir et livrer des logiciels web et mobile. J'écris du code robuste et maintenable avec un focus sur la simplicité et la performance. Pragmatique, je sais aussi déléguer à l'I.A. quand ça fait sens, <strong>en gardant la maîtrise sur la qualité</strong>.
      </p>
      <div class="hero__ctas">
        <a href="#contact" class="hero__cta hero__cta--primary">
          Me contacter
          <IconArrowRight aria-hidden="true" />
        </a>
        <a href="#projets" class="hero__cta hero__cta--secondary">Voir mes projets</a>
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero__photo-frame">
        <Image alt="" src={portrait} width="420" fetchpriority="high" loading="eager" />
      </div>

      <aside class="hero__code">
        <pre aria-hidden="true"><code set:html={highlighted} /></pre>
        <p class="sr-only">J'ai écrit ici un extrait de code PHP humoristique. Dans un bloc "try catch" j'appelle un service "brew coffee query" qui me retourne une tasse de café, que je bois. En cas d'absence de café, une exception "Out Of Beans Exception" est levée, et un message est envoyé à Sentry qui indique "La journée va être compliquée…".</p>
      </aside>
    </div>
  </div>
</div>

<script>
  document.body.setAttribute('data-hero', 'code');
</script>

<style>
  .hero { padding: var(--tc-space-9) 0 var(--tc-space-8); }
  .hero > div {
    display: grid; grid-template-columns: 1.25fr 1fr;
    gap: var(--tc-space-8); align-items: flex-start;
  }

  h1 {
    font-size: clamp(40px, 6vw, 68px);
    letter-spacing: -0.03em;
    margin: 0 0 var(--tc-space-5);
  }
  h1 span {
    background: linear-gradient(transparent 65%, #9889fe 65%);
    padding: 0 4px;
  }
  .hero__lead {
    font-size: 19px; line-height: 1.55;
    color: var(--tc-fg-2);
    max-width: 52ch;
    margin: 0 0 var(--tc-space-6);
  }
  .hero__lead strong { font-size: 1.125rem; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--tc-space-3); align-items: center; }
  .hero__cta {
    display: inline-flex; align-items: center; gap: var(--tc-space-2);
    padding: 14px 24px;
    font-family: var(--tc-font-sans); font-weight: 700; font-size: 16px;
    text-decoration: none;
    border: var(--tc-border); border-radius: var(--tc-radius);
    box-shadow: var(--tc-shadow-sm);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  .hero__cta:hover { transform: translate(-1px, -1px); box-shadow: var(--tc-shadow); }
  .hero__cta:active { transform: translate(1px, 1px); box-shadow: var(--tc-shadow-sm); }
  .hero__cta:focus-visible { outline: 3px solid var(--tc-accent); outline-offset: 2px; }
  .hero__cta--primary  { background: var(--tc-fg-1); color: var(--tc-bg); }
  .hero__cta--secondary { background: var(--tc-bg); color: var(--tc-fg-1); }
  .hero__cta :global(svg) { width: 18px; height: 18px; }

  /* Visual */
  .hero__visual { position: relative; max-width: 420px; justify-self: end; width: 100%; }

  .hero__photo-frame {
    position: relative;
    border: var(--tc-border); border-radius: var(--tc-radius);
    box-shadow: var(--tc-shadow-accent);
    overflow: hidden;
    background: var(--tc-accent-soft);
    aspect-ratio: 4 / 5;
  }
  .hero__photo-frame :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: center 20%;
  }

  .hero__code {
    position: absolute;
    right: 40px; bottom: -100px;
    width: min(360px, 80%);
    background: var(--tc-fg-1);
    color: var(--tc-bg);
    border: var(--tc-border); border-radius: var(--tc-radius);
    padding: 18px 20px 10px 20px;
    font-family: var(--tc-font-mono); font-size: 12px; line-height: 1.6;
    box-shadow: var(--tc-shadow);
    display: block;
  }
  .hero__code pre { margin: 0; white-space: pre-wrap; word-break: break-all; }
  .hero__code code {
    font-family: inherit; font-size: inherit;
    background: transparent; padding: 0;
  }
  /* highlight.js — atom-one-dark, background overridden */
  .hero__code :global(.hljs)                          { color: #abb2bf; background: transparent; }
  .hero__code :global(.hljs-comment)                  { color: #5c6370; font-style: italic; }
  .hero__code :global(.hljs-keyword)                  { color: #c678dd; }
  .hero__code :global(.hljs-string)                   { color: #98c379; }
  .hero__code :global(.hljs-variable)                 { color: #d19a66; }
  .hero__code :global(.hljs-title.class_),
  .hero__code :global(.hljs-built_in)                 { color: #e6c07b; }
  .hero__code :global(.hljs-title.function_)          { color: #61aeee; }
  .hero__code :global(.hljs-name),
  .hero__code :global(.hljs-selector-tag)             { color: #e06c75; }

  @media (min-width: 1264px) {
    .hero__code { right: -50px; }
  }

  @media (max-width: 760px) {
    .hero { padding: var(--tc-space-7) 0; margin-bottom: 30px; }
    .hero > div { grid-template-columns: 1fr; gap: var(--tc-space-7); }
    .hero__visual { justify-self: stretch; max-width: 360px; margin: 0 auto; }
    .hero__code { right: -50px; bottom: -100px; width: min(280px, 90%); }
  }

  @media (max-width: 500px) {
    .hero__code { right: 40px; }
  }
</style>
