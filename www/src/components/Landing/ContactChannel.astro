---
import IconArrowUpRight from '../icons/IconArrowUpRight.astro';

interface Props {
  href: string;
  label: string;
  value: string;
  external?: boolean;
}

const { href, label, value, external = false } = Astro.props;
const attrs = external
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};

let ariaLabel = `${label} : ${value}${external ? ', nouvelle fenêtre' : ''}`;
if (label === 'CV') {
  ariaLabel = `Mon Curriculum Vitae en ligne, nouvelle fenêtre`;
}
---

<a class="contact-channel" href={href} {...attrs} aria-label={ariaLabel}>
  <div class="contact-channel__icon" aria-hidden="true">
    <slot name="icon" />
  </div>
  <div>
    <div aria-hidden="true" class="contact-channel__label">{label}</div>
    <div aria-hidden="true" class="contact-channel__value">{value}</div>
  </div>
  <span class="contact-channel__arrow" aria-hidden="true">
    <IconArrowUpRight />
  </span>
</a>

<style>
  .contact-channel {
    display: flex; align-items: center; gap: var(--tc-space-4);
    padding: 18px 24px;
    background: var(--tc-surface);
    border: var(--tc-border); border-radius: var(--tc-radius);
    box-shadow: var(--tc-shadow-sm);
    text-decoration: none;
    color: var(--tc-fg-1);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  .contact-channel:hover { transform: translate(-2px, -2px); box-shadow: var(--tc-shadow); }
  .contact-channel:focus-visible { outline: 3px solid var(--tc-accent); outline-offset: 2px; }
  .contact-channel__icon {
    width: 48px; height: 48px; flex: 0 0 48px;
    display: flex; align-items: center; justify-content: center;
    border: var(--tc-border); border-radius: var(--tc-radius);
    background: var(--tc-accent);
  }
  .contact-channel__icon :global(svg) { width: 24px; height: 24px; stroke-width: 2; }
  .contact-channel__label {
    font-family: var(--tc-font-mono); font-size: 12px;
    text-transform: uppercase; letter-spacing: 0.05em; color: var(--tc-fg-3);
  }
  .contact-channel__value {
    font-family: var(--tc-font-display); font-size: 20px;
    font-weight: 700; line-height: 1.2; letter-spacing: -0.01em;
  }
  .contact-channel__arrow { margin-left: auto; }
  .contact-channel__arrow :global(svg) { width: 24px; height: 24px; }


  @media (max-width: 420px) {
    .contact-channel__icon { display: none; }
      .contact-channel__value { font-size: 18px;}
  }
</style>
