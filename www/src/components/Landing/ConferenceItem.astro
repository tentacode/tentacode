---
import IconArrowUpRight from '../icons/IconArrowUpRight.astro';
import { expandFrenchMonths } from '../../utils/dates';

interface Occurrence {
  event: string;
  date: string;
}

interface Props {
  title: string;
  occurrences: Occurrence[];
  cohost?: string;
  cohostUrl?: string;
  linkLabel: string;
  href: string;
}

const { title, occurrences, cohost, cohostUrl, linkLabel, href } = Astro.props;
---

<div class="conf">
  <div class="conf__main">
    <h3 class="conf__title">{title}</h3>
    {cohost && (
      <p class="conf__cohost">
        avec{' '}
        {cohostUrl
          ? <a href={cohostUrl} target="_blank" rel="noopener noreferrer"><strong>{cohost}<span class="sr-only">, nouvelle fenêtre</span></strong><IconArrowUpRight aria-hidden="true" /></a>
          : <strong>{cohost}</strong>
        }
      </p>
    )}
  </div>
  <div class="conf__when">
    {occurrences.length === 1 ? (
      <span class="conf__occ">
        <strong>{occurrences[0].event}</strong>
        <span aria-label={expandFrenchMonths(occurrences[0].date)}>{occurrences[0].date}</span>
      </span>
    ) : (
      <ul class="conf__list">
        {occurrences.map((occ) => (
          <li class="conf__occ">
            <strong>{occ.event}</strong>
            <span aria-label={expandFrenchMonths(occ.date)}>{occ.date}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
  <a class="link-detail" href={href} aria-label={`${linkLabel} : ${title}`} target="_blank" rel="noopener noreferrer">
    {linkLabel}
    <IconArrowUpRight aria-hidden="true" />
  </a>
</div>

<style>
  .conf {
    display: grid;
    grid-template-columns: minmax(0, 220px) 1fr auto;
    gap: var(--tc-space-6);
    align-items: start;
    padding: var(--tc-space-5) 0;
    border-bottom: 1px solid var(--tc-fg-1);
  }
  .conf__when {
    order: 1;
  }
  .conf__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--tc-space-3);
  }
  .conf__occ {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding-left: 14px;
    position: relative;
  }
  .conf__occ::before {
    content: "";
    position: absolute;
    left: 0; top: 6px;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--tc-accent);
    border: 1px solid var(--tc-fg-1);
  }
  .conf__occ strong {
    font-family: var(--tc-font-sans);
    font-weight: 700;
    font-size: 14px;
    color: var(--tc-fg-1);
    line-height: 1.25;
  }
  .conf__occ span {
    font-family: var(--tc-font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--tc-fg-3);
  }
  .conf__main { display: flex; flex-direction: column; gap: 4px; align-self: start; order: 2; }
  .conf__title {
    font-family: var(--tc-font-display); font-size: 20px;
    font-weight: 600; margin: 0;
    color: var(--tc-fg-1); letter-spacing: -0.01em;
  }
  .conf__cohost { font-size: 13px; color: var(--tc-fg-3); margin: 0; }
  .conf__cohost strong { font-weight: 700; color: var(--tc-fg-2); }
  .conf__cohost a { color: inherit; text-decoration: underline; display: inline-flex; align-items: center; gap: 2px; }
  .conf__cohost a:focus-visible { outline: 3px solid var(--tc-pink); outline-offset: 2px; border-radius: 2px; }
  .conf__cohost a :global(svg) { width: 10px; height: 10px; flex-shrink: 0; }
  .link-detail {
    order: 3;
    font-family: var(--tc-font-mono); font-size: 12px;
    text-decoration: none;
    color: var(--tc-fg-1);
    padding: 6px 10px;
    border: 2px solid var(--tc-fg-1); border-radius: 8px;
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--tc-bg);
    white-space: nowrap;
    align-self: start;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  .link-detail:hover { transform: translate(-1px, -1px); box-shadow: var(--tc-shadow-sm); }
  .link-detail:focus-visible { outline: 3px solid var(--tc-pink); outline-offset: 2px; }
  .link-detail :global(svg) { width: 12px; height: 12px; }

  @media (max-width: 760px) {
    .conf { grid-template-columns: 1fr; gap: var(--tc-space-2); padding: var(--tc-space-4) 0; }
    .link-detail { justify-self: start; }
  }
</style>
