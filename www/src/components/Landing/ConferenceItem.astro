---
import IconArrowRight from '../icons/IconArrowRight.astro';

interface Occurrence {
  event: string;
  date: string;
}

interface Props {
  title: string;
  occurrences: Occurrence[];
  cohost: string;
  href: string;
}

const { title, occurrences, cohost, href } = Astro.props;
---

<li class="conf">
  <div class="conf__when">
    {occurrences.map((occ) => (
      <span class="conf__occ">
        <strong>{occ.event}</strong>
        <span>{occ.date}</span>
      </span>
    ))}
  </div>
  <div class="conf__main">
    <p class="conf__title">{title}</p>
    <p class="conf__cohost" set:html={cohost} />
  </div>
  <a href={href} aria-label={`Détails de la conférence : ${title}`}>
    Voir
    <IconArrowRight aria-hidden="true" />
  </a>
</li>

<style>
  .conf {
    display: grid;
    grid-template-columns: 220px 1fr auto;
    gap: var(--tc-space-6);
    align-items: start;
    padding: var(--tc-space-5) 0;
    border-bottom: 1px solid var(--tc-fg-1);
  }
  .conf__when {
    display: flex;
    flex-direction: column;
    gap: var(--tc-space-3);
  }
  .conf__occ {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding-left: 14px;
    position: relative;
  }
  .conf__occ::before {
    content: "";
    position: absolute;
    left: 0; top: 6px;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--tc-accent);
    border: 1px solid var(--tc-fg-1);
  }
  .conf__occ strong {
    font-family: var(--tc-font-sans);
    font-weight: 700;
    font-size: 14px;
    color: var(--tc-fg-1);
    line-height: 1.25;
  }
  .conf__occ span {
    font-family: var(--tc-font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--tc-fg-3);
  }
  .conf__main { display: flex; flex-direction: column; gap: 4px; align-self: center; }
  .conf__title {
    font-family: var(--tc-font-display); font-size: 20px;
    font-weight: 600; margin: 0;
    color: var(--tc-fg-1); letter-spacing: -0.01em;
  }
  .conf__cohost { font-size: 13px; color: var(--tc-fg-3); margin: 0; }
  .conf__cohost :global(strong) { font-weight: 700; color: var(--tc-fg-2); }
  a {
    font-family: var(--tc-font-mono); font-size: 12px;
    text-decoration: none;
    color: var(--tc-fg-1);
    padding: 6px 10px;
    border: 2px solid var(--tc-fg-1); border-radius: 8px;
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--tc-bg);
    white-space: nowrap;
    align-self: center;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  a:hover { transform: translate(-1px, -1px); box-shadow: var(--tc-shadow-sm); }
  a:focus-visible { outline: 3px solid var(--tc-accent); outline-offset: 2px; }
  a :global(svg) { width: 12px; height: 12px; }

  @media (max-width: 760px) {
    .conf { grid-template-columns: 1fr; gap: var(--tc-space-2); padding: var(--tc-space-4) 0; }
    a { justify-self: start; }
  }
</style>
