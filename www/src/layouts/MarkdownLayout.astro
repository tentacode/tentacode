---
import Base from './Base.astro';
import HeaderSecondary from '../components/HeaderSecondary.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  frontmatter?: { title: string; description?: string };
}

const props = Astro.props.frontmatter ?? Astro.props;
const { title, description } = props;
---

<Base title={`${title} — tentacode.dev`} description={description}>
  <a class="tc-skip" href="#main-content">Aller au contenu principal</a>
  <HeaderSecondary />

  <main id="main-content">
    <div class="tc-container">
      <slot name="header">
        <header class="page-header">
          <h1>{title}</h1>
          {description && <p class="page-header__description">{description}</p>}
        </header>
      </slot>

      <article class="prose-content">
        <slot />
      </article>

      <slot name="footer" />
    </div>
  </main>

  <Footer />
</Base>

<style>
  .page-header {
    padding: var(--tc-space-8) 0 var(--tc-space-6);
    max-width: 72ch;
    margin-bottom: var(--tc-space-7);
    margin-inline: auto;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: var(--tc-space-3);
  }

  .page-header__description {
    font-size: var(--tc-fs-h5);
    color: var(--tc-fg-3);
    line-height: var(--tc-lh-relaxed);
    margin: 0;
  }

  .prose-content {
    max-width: 72ch;
    margin-inline: auto;
    padding-bottom: var(--tc-space-9);
    font-size: var(--tc-fs-body);
    line-height: var(--tc-lh-relaxed);
  }
  .prose-content :global(h2) {
    font-size: var(--tc-fs-h3);
    margin-top: var(--tc-space-8);
    margin-bottom: var(--tc-space-4);
    padding-bottom: var(--tc-space-3);
    border-bottom: var(--tc-border);
  }
  .prose-content :global(h3) {
    font-size: var(--tc-fs-h4);
    margin-top: var(--tc-space-6);
    margin-bottom: var(--tc-space-3);
  }
  .prose-content :global(p) { margin-bottom: var(--tc-space-4); }
  .prose-content :global(ul),
  .prose-content :global(ol) {
    padding-left: var(--tc-space-5);
    margin-bottom: var(--tc-space-4);
  }
  .prose-content :global(li) { margin-bottom: var(--tc-space-2); }
  .prose-content :global(pre) {
    background: var(--tc-fg-1);
    color: var(--tc-bg);
    padding: var(--tc-space-5);
    border-radius: var(--tc-radius-sm);
    overflow-x: auto;
    margin-bottom: var(--tc-space-5);
    font-family: var(--tc-font-mono);
    font-size: 14px;
    line-height: 1.6;
  }
  .prose-content :global(code) {
    font-family: var(--tc-font-mono);
    font-size: 0.875em;
    background: var(--tc-accent-soft);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .prose-content :global(pre code) {
    background: none;
    padding: 0;
  }
  .prose-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--tc-space-5);
    font-size: var(--tc-fs-small);
  }
  .prose-content :global(th),
  .prose-content :global(td) {
    padding: var(--tc-space-3) var(--tc-space-4);
    border: 2px solid var(--tc-fg-1);
    text-align: left;
  }
  .prose-content :global(th) {
    background: var(--tc-fg-1);
    color: var(--tc-bg);
    font-family: var(--tc-font-display);
  }
  .prose-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--tc-radius);
    margin-block: var(--tc-space-5);
    display: block;
  }
  .prose-content :global(a) {
    color: var(--tc-accent);
  }
  .prose-content :global(a:hover) {
    text-decoration: wavy underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  @media (max-width: 760px) {
    .page-header { padding: var(--tc-space-6) 0 var(--tc-space-4); }
  }
</style>
