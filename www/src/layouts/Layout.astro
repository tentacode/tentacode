---
import '../styles/global.css';

const startedWorkingOn = new Date('2006-09-01');
const interval = Date.now() - startedWorkingOn.getTime();
const yearsOfExperience = Math.floor(interval / (1000 * 60 * 60 * 24 * 365.25));
---

<!doctype html>
<html lang="fr">
	<head>
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<meta name="description" content={`${yearsOfExperience} années d'expertise dans le développement logiciel au service de l'accessibilité dans votre équipe technique.`} />

		<meta property="og:type" content="website">
		<meta property="og:url" content="https://tentacode.dev/">
		<meta property="og:title" content="Gabriel Pillet • tentacode.dev • Accessibilité, Conseil et Développement">
		<meta property="og:description" content={`${yearsOfExperience} années d'expertise dans le développement web et mobile, aujourd'hui au service de l'accessibilité numérique pour vos projets.`}>
		<meta property="og:image" content="https://tentacode.dev/images/og-image.jpg">
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">
		<meta property="og:locale" content="fr_FR">

		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:url" content="https://tentacode.dev/">
		<meta name="twitter:title" content="Gabriel Pillet • tentacode.dev • Accessibilité, Conseil et Développement">
		<meta name="twitter:description" content={`${yearsOfExperience} années d'expertise dans le développement web et mobile, aujourd'hui au service de l'accessibilité numérique pour vos projets.`}>
		<meta name="twitter:image" content="https://tentacode.dev/images/og-image.jpg">

		<link
			rel="preload"
			href="/fonts/LexendDeca-VariableFont_wght.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<title>Gabriel Pillet • tentacode.dev • Accessibilité, Conseil et Développement</title>

		<script is:inline>
			const stored = localStorage.getItem('theme');
			const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			document.documentElement.dataset.theme = stored || preferred;
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background: var(--background);
		color: var(--text);
		font-size: 16px;
	}
</style>