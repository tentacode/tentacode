---
import MarkdownLayout from './MarkdownLayout.astro';

interface Props {
  title: string;
  description: string;
  tags: string[];
  client?: string;
  role?: string;
  href?: string;
}

const { title, description, tags, client, role, href } = Astro.props;

const meta = [
  client && { label: 'Client', value: client },
  role   && { label: 'Rôle',   value: role },
].filter(Boolean) as { label: string; value: string }[];
---

<MarkdownLayout title={title} description={description}>
  <header class="project-hero" slot="header">
    <a class="back-link" href="/#projects">
      ← Tous les projets
    </a>
    <div class="project-hero__tags">
      {tags.map((tag) => <span class="project-tag">{tag}</span>)}
    </div>
    <h1>{title}</h1>
    <p class="project-hero__description">{description}</p>

    {meta.length > 0 && (
      <dl class="project-meta">
        {meta.map(({ label, value }) => (
          <div class="project-meta__item">
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    )}

    {href && (
      <a class="project-link" href={href} target="_blank" rel="noopener noreferrer">
        Voir le projet →
      </a>
    )}
  </header>

  <slot />

  <!-- <aside class="signature-block" slot="footer" aria-label="À propos de l'auteur">
    <div class="signature-block__inner">
      <div class="signature-block__text">
        <p>
          <strong>Gabriel Pillet</strong> est développeur fullstack freelance, lead technique et expert accessibilité basé en France.
          Il accompagne des équipes produit sur des projets web exigeants — de l'audit RGAA à la mise en production.
        </p>
        <a href="/">Voir le profil complet sur tentacode.dev →</a>
      </div>
    </div>
  </aside> -->
</MarkdownLayout>

<style>
  .project-hero {
    padding: var(--tc-space-8) 0 var(--tc-space-7);
    max-width: 72ch;
  }

  .back-link {
    display: inline-block;
    font-size: var(--tc-fs-small);
    font-weight: var(--tc-weight-semibold);
    color: var(--tc-fg-3);
    text-decoration: none;
    margin-bottom: var(--tc-space-5);
  }
  .back-link:hover { color: var(--tc-fg-1); text-decoration: underline; }
  .back-link:focus-visible { outline: 3px solid var(--tc-accent); outline-offset: 3px; border-radius: 3px; }

  .project-hero__tags {
    display: flex; flex-wrap: wrap; gap: 6px;
    margin-bottom: var(--tc-space-4);
  }
  .project-tag {
    font-family: var(--tc-font-mono); font-size: 12px;
    padding: 3px 10px;
    background: var(--tc-surface); border: 2px solid var(--tc-fg-1);
    border-radius: 6px; color: var(--tc-fg-1); line-height: 1.4;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: var(--tc-space-4);
  }

  .project-hero__description {
    font-size: var(--tc-fs-h5);
    color: var(--tc-fg-3);
    line-height: var(--tc-lh-relaxed);
    margin-bottom: var(--tc-space-6);
  }

  .project-meta {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: var(--tc-space-3) var(--tc-space-5);
    margin: 0;
    padding: var(--tc-space-5);
    background: var(--tc-surface);
    border: var(--tc-border);
    border-radius: var(--tc-radius);
    box-shadow: var(--tc-shadow-sm);
  }
  .project-meta__item dt {
    font-size: var(--tc-fs-micro);
    font-weight: var(--tc-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tc-ls-wide);
    color: var(--tc-fg-4);
    margin-bottom: 4px;
  }
  .project-meta__item dd {
    margin: 0;
    font-weight: var(--tc-weight-semibold);
    color: var(--tc-fg-1);
    font-size: var(--tc-fs-small);
  }

  .project-link {
    display: inline-block;
    margin-top: var(--tc-space-5);
    font-weight: var(--tc-weight-semibold);
    font-size: var(--tc-fs-small);
    color: var(--tc-accent-deep);
    text-decoration: none;
  }
  .project-link:hover { text-decoration: underline; }
  .project-link:focus-visible { outline: 3px solid var(--tc-accent); outline-offset: 3px; border-radius: 3px; }

  .signature-block {
    border-top: var(--tc-border);
    padding: var(--tc-space-7) 0 var(--tc-space-9);
  }
  .signature-block__inner {
    display: flex;
    align-items: flex-start;
    gap: var(--tc-space-5);
    max-width: 72ch;
    padding: var(--tc-space-5) var(--tc-space-6);
    background: var(--tc-accent-soft);
    border: var(--tc-border);
    border-radius: var(--tc-radius);
    box-shadow: var(--tc-shadow-sm);
  }
  .signature-block__text p {
    margin: 0 0 var(--tc-space-3);
    font-size: var(--tc-fs-small);
    color: var(--tc-fg-2);
    max-width: none;
  }
  .signature-block__text a {
    font-weight: var(--tc-weight-semibold);
    font-size: var(--tc-fs-small);
    color: var(--tc-accent-deep);
  }

  @media (max-width: 760px) {
    .project-hero { padding: var(--tc-space-6) 0 var(--tc-space-5); }
    .project-meta { grid-template-columns: repeat(2, 1fr); }
  }
</style>
