---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  tags: string[];
  client?: string;
  role?: string;
  duration?: string;
  outcome?: string;
}

const { title, description, tags, client, role, duration, outcome } = Astro.props;

const meta = [
  client   && { label: 'Client',    value: client },
  role     && { label: 'Rôle',      value: role },
  duration && { label: 'Durée',     value: duration },
  outcome  && { label: 'Résultat',  value: outcome },
].filter(Boolean) as { label: string; value: string }[];
---

<Base title={`${title} — tentacode.dev`} description={description}>
  <a class="tc-skip" href="#main-content">Aller au contenu principal</a>
  <Header />

  <main id="main-content">
    <div class="tc-container">
      <header class="project-hero">
        <a class="back-link" href="/#projects">
          ← Tous les projets
        </a>
        <div class="project-hero__tags">
          {tags.map((tag) => <span class="project-tag">{tag}</span>)}
        </div>
        <h1>{title}</h1>
        <p class="project-hero__description">{description}</p>

        {meta.length > 0 && (
          <dl class="project-meta">
            {meta.map(({ label, value }) => (
              <div class="project-meta__item">
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
        )}
      </header>

      <article class="project-content">
        <slot />
      </article>

      <aside class="signature-block" aria-label="À propos de l'auteur">
        <div class="signature-block__inner">
          <div class="signature-block__text">
            <p>
              <strong>Gabriel Pillet</strong> est développeur fullstack freelance, lead technique et expert accessibilité basé en France.
              Il accompagne des équipes produit sur des projets web exigeants — de l'audit RGAA à la mise en production.
            </p>
            <a href="/">Voir le profil complet sur tentacode.dev →</a>
          </div>
        </div>
      </aside>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .project-hero {
    padding: var(--tc-space-8) 0 var(--tc-space-7);
    max-width: 72ch;
  }

  .back-link {
    display: inline-block;
    font-size: var(--tc-fs-small);
    font-weight: var(--tc-weight-semibold);
    color: var(--tc-fg-3);
    text-decoration: none;
    margin-bottom: var(--tc-space-5);
  }
  .back-link:hover { color: var(--tc-fg-1); text-decoration: underline; }
  .back-link:focus-visible { outline: 3px solid var(--tc-accent); outline-offset: 3px; border-radius: 3px; }

  .project-hero__tags {
    display: flex; flex-wrap: wrap; gap: 6px;
    margin-bottom: var(--tc-space-4);
  }
  .project-tag {
    font-family: var(--tc-font-mono); font-size: 12px;
    padding: 3px 10px;
    background: var(--tc-surface); border: 2px solid var(--tc-fg-1);
    border-radius: 6px; color: var(--tc-fg-1); line-height: 1.4;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: var(--tc-space-4);
  }

  .project-hero__description {
    font-size: var(--tc-fs-h5);
    color: var(--tc-fg-3);
    line-height: var(--tc-lh-relaxed);
    margin-bottom: var(--tc-space-6);
  }

  .project-meta {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: var(--tc-space-3) var(--tc-space-5);
    margin: 0;
    padding: var(--tc-space-5);
    background: var(--tc-surface);
    border: var(--tc-border);
    border-radius: var(--tc-radius);
    box-shadow: var(--tc-shadow-sm);
  }
  .project-meta__item dt {
    font-size: var(--tc-fs-micro);
    font-weight: var(--tc-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tc-ls-wide);
    color: var(--tc-fg-4);
    margin-bottom: 4px;
  }
  .project-meta__item dd {
    margin: 0;
    font-weight: var(--tc-weight-semibold);
    color: var(--tc-fg-1);
    font-size: var(--tc-fs-small);
  }

  .project-content {
    max-width: 72ch;
    padding-bottom: var(--tc-space-9);
    font-size: var(--tc-fs-body);
    line-height: var(--tc-lh-relaxed);
  }
  .project-content :global(h2) {
    font-size: var(--tc-fs-h3);
    margin-top: var(--tc-space-8);
    margin-bottom: var(--tc-space-4);
    padding-bottom: var(--tc-space-3);
    border-bottom: var(--tc-border);
  }
  .project-content :global(h3) {
    font-size: var(--tc-fs-h4);
    margin-top: var(--tc-space-6);
    margin-bottom: var(--tc-space-3);
  }
  .project-content :global(p) { margin-bottom: var(--tc-space-4); }
  .project-content :global(ul),
  .project-content :global(ol) {
    padding-left: var(--tc-space-5);
    margin-bottom: var(--tc-space-4);
  }
  .project-content :global(li) { margin-bottom: var(--tc-space-2); }
  .project-content :global(pre) {
    background: var(--tc-fg-1);
    color: var(--tc-bg);
    padding: var(--tc-space-5);
    border-radius: var(--tc-radius-sm);
    overflow-x: auto;
    margin-bottom: var(--tc-space-5);
    font-family: var(--tc-font-mono);
    font-size: 14px;
    line-height: 1.6;
  }
  .project-content :global(code) {
    font-family: var(--tc-font-mono);
    font-size: 0.875em;
    background: var(--tc-accent-soft);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .project-content :global(pre code) {
    background: none;
    padding: 0;
  }
  .project-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--tc-space-5);
    font-size: var(--tc-fs-small);
  }
  .project-content :global(th),
  .project-content :global(td) {
    padding: var(--tc-space-3) var(--tc-space-4);
    border: 2px solid var(--tc-fg-1);
    text-align: left;
  }
  .project-content :global(th) {
    background: var(--tc-fg-1);
    color: var(--tc-bg);
    font-family: var(--tc-font-display);
  }

  .signature-block {
    border-top: var(--tc-border);
    padding: var(--tc-space-7) 0 var(--tc-space-9);
  }
  .signature-block__inner {
    display: flex;
    align-items: flex-start;
    gap: var(--tc-space-5);
    max-width: 72ch;
    padding: var(--tc-space-5) var(--tc-space-6);
    background: var(--tc-accent-soft);
    border: var(--tc-border);
    border-radius: var(--tc-radius);
    box-shadow: var(--tc-shadow-sm);
  }
  .signature-block__text p {
    margin: 0 0 var(--tc-space-3);
    font-size: var(--tc-fs-small);
    color: var(--tc-fg-2);
    max-width: none;
  }
  .signature-block__text a {
    font-weight: var(--tc-weight-semibold);
    font-size: var(--tc-fs-small);
    color: var(--tc-accent-deep);
  }

  @media (max-width: 760px) {
    .project-hero { padding: var(--tc-space-6) 0 var(--tc-space-5); }
    .project-meta { grid-template-columns: repeat(2, 1fr); }
  }
</style>
