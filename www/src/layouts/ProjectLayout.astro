---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import MarkdownLayout from './MarkdownLayout.astro';
import IconArrowLeft from '../components/icons/IconArrowLeft.astro';
import IconArrowRight from '../components/icons/IconArrowRight.astro';
import IconArrowUpRight from '../components/icons/IconArrowUpRight.astro';

interface ProjectRef {
  title: string;
  slug: string;
}

interface Props {
  title: string;
  description: string;
  tags: string[];
  image: ImageMetadata;
  imageAlt: string;
  href?: string;
  prevProject?: ProjectRef;
  nextProject?: ProjectRef;
}

const { title, description, tags, image, imageAlt, href, prevProject, nextProject } = Astro.props;
---

<MarkdownLayout title={title} description={description}>
  <header class="project-hero" slot="header">
    {(prevProject || nextProject) && (
      <nav class="project-nav">
        {prevProject && (
          <a class="nav-prev" href={`/projets/${prevProject.slug}`}>
            <IconArrowLeft aria-hidden="true" width="16" height="16" />
            {prevProject.title}
          </a>
        )}
        {nextProject && (
          <a class="nav-next" href={`/projets/${nextProject.slug}`}>
            {nextProject.title}
            <IconArrowRight aria-hidden="true" width="16" height="16" />
          </a>
        )}
      </nav>
    )}

    <figure class="project-cover">
      <Image src={image} alt={imageAlt} />
    </figure>
    <div class="project-hero__tags">
      {tags.map((tag) => <span class="project-tag">{tag}</span>)}
    </div>
    <h1>{title}</h1>
    <p class="project-hero__description">{description}</p>

    {href && (
      <a aria-label={`Voir le projet, nouvelle fenêtre`} class="project-cta" href={href} target="_blank" rel="noopener noreferrer">
        Voir le projet
        <IconArrowUpRight aria-hidden="true" width="18" height="18" />
      </a>
    )}
  </header>

  <slot />
</MarkdownLayout>

<style>
  .project-hero {
    padding: var(--tc-space-8) 0 var(--tc-space-7);
    max-width: 72ch;
    margin-inline: auto;
  }

  .project-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--tc-space-4);
    margin-bottom: var(--tc-space-6);
  }
  .project-nav a {
    display: inline-flex;
    align-items: center;
    gap: var(--tc-space-2);
    padding: 10px 18px;
    font-family: var(--tc-font-sans);
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    color: var(--tc-fg-1);
    background: var(--tc-bg);
    border: var(--tc-border);
    border-radius: var(--tc-radius);
    box-shadow: var(--tc-shadow-sm);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 45%;
  }
  .project-nav a:hover { transform: translate(-1px, -1px); box-shadow: var(--tc-shadow); }
  .project-nav a:active { transform: translate(1px, 1px); box-shadow: var(--tc-shadow-sm); }
  .project-nav a:focus-visible { outline: 3px solid var(--tc-accent); outline-offset: 2px; }
  .project-nav .nav-next { margin-left: auto; }
  .project-nav :global(svg) { flex-shrink: 0; }

  .project-cover {
    margin: 0 0 var(--tc-space-7);
    border-radius: var(--tc-radius);
    box-shadow: var(--tc-shadow-accent);
    overflow: hidden;
  }
  .project-cover :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .project-hero__tags {
    display: flex; flex-wrap: wrap; gap: 6px;
    margin-bottom: var(--tc-space-4);
  }
  .project-tag {
    font-family: var(--tc-font-mono); font-size: 12px;
    padding: 3px 10px;
    background: var(--tc-surface); border: 2px solid var(--tc-fg-1);
    border-radius: 6px; color: var(--tc-fg-1); line-height: 1.4;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: var(--tc-space-4);
  }

  .project-hero__description {
    font-size: var(--tc-fs-h5);
    color: var(--tc-fg-3);
    line-height: var(--tc-lh-relaxed);
    margin-bottom: var(--tc-space-6);
  }

  .project-cta {
    display: inline-flex; align-items: center; gap: var(--tc-space-2);
    padding: 14px 24px;
    font-family: var(--tc-font-sans); font-weight: 700; font-size: 16px;
    text-decoration: none;
    border: var(--tc-border); border-radius: var(--tc-radius);
    box-shadow: var(--tc-shadow-sm);
    background: var(--tc-fg-1); color: var(--tc-bg);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  .project-cta:hover { transform: translate(-1px, -1px); box-shadow: var(--tc-shadow); }
  .project-cta:active { transform: translate(1px, 1px); box-shadow: var(--tc-shadow-sm); }
  .project-cta:focus-visible { outline: 3px solid var(--tc-accent); outline-offset: 2px; }

  @media (max-width: 760px) {
    .project-hero { padding: var(--tc-space-6) 0 var(--tc-space-5); }
  }
</style>
