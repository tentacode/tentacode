---
import Footer from '../components/Footer.astro';
import Header from '../components/Header/Header.astro';
import Hero from '../components/Hero.astro';
import AboutMe from '../components/Sections/AboutMe.astro';
import Contact from '../components/Sections/Contact.astro';
import Missions from '../components/Sections/Missions.astro';
import Portfolio from '../components/Sections/Portfolio.astro';
import Talks from '../components/Sections/Talks.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<Header />
	<main>
		<Hero />
		<AboutMe />
		<Missions />
		<Portfolio />
		<Talks />
		<Contact />
	</main>
	<Footer />
</Layout>

<style>
	main {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 70px;
		margin-bottom: 70px;
	}
</style>